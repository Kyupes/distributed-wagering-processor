        },
        {
          "name": "wager_transactions_currency_check",
          "expression": "currency ~ '^[A-Z]{3}$'::text",
          "definition": "CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))",
          "columnName": "currency"
        },
        {
          "name": "wager_transactions_kind_check",
          "expression": "(kind = ANY (ARRAY['BET'::character varying, 'WIN'::character varying, 'LOSS'::character varying, 'REFUND'::character varying, 'ROLLBACK'::character varying])) OR ((kind = 'OPENING'::text) AND (status = 'PROCESSED'::text) AND (provider_id = '__internal__'::text) AND (round_id = '__opening__'::text) AND (game_id = '__internal__'::text))",
          "definition": "CHECK ((((kind)::text = ANY ((ARRAY['BET'::character varying, 'WIN'::character varying, 'LOSS'::character varying, 'REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) OR (((kind)::text = 'OPENING'::text) AND ((status)::text = 'PROCESSED'::text) AND ((provider_id)::text = '__internal__'::text) AND ((round_id)::text = '__opening__'::text) AND ((game_id)::text = '__internal__'::text))))",
          "columnName": "game_id"
        },
        {
          "name": "wager_transactions_reference_shape_check",
          "expression": "(reference_attempts >= 0) AND ((reference_transaction_id IS NULL) OR (reference_transaction_id <> id)) AND ((reference_transaction_id IS NULL) OR (reference_external_transaction_id IS NOT NULL)) AND (((kind = ANY (ARRAY['BET'::character varying, 'LOSS'::character varying, 'OPENING'::character varying])) AND (reference_external_transaction_id IS NULL) AND (reference_transaction_id IS NULL)) OR (kind = 'WIN'::text) OR ((kind = ANY (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])) AND (reference_external_transaction_id IS NOT NULL))) AND (((status = 'PENDING_REFERENCE'::text) AND (reference_external_transaction_id IS NOT NULL) AND (reference_transaction_id IS NULL) AND (next_reference_attempt_at IS NOT NULL)) OR ((status <> 'PENDING_REFERENCE'::text) AND (next_reference_attempt_at IS NULL)))",
          "definition": "CHECK (((reference_attempts >= 0) AND ((reference_transaction_id IS NULL) OR (reference_transaction_id <> id)) AND ((reference_transaction_id IS NULL) OR (reference_external_transaction_id IS NOT NULL)) AND ((((kind)::text = ANY ((ARRAY['BET'::character varying, 'LOSS'::character varying, 'OPENING'::character varying])::text[])) AND (reference_external_transaction_id IS NULL) AND (reference_transaction_id IS NULL)) OR ((kind)::text = 'WIN'::text) OR (((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) AND (reference_external_transaction_id IS NOT NULL))) AND ((((status)::text = 'PENDING_REFERENCE'::text) AND (reference_external_transaction_id IS NOT NULL) AND (reference_transaction_id IS NULL) AND (next_reference_attempt_at IS NOT NULL)) OR (((status)::text <> 'PENDING_REFERENCE'::text) AND (next_reference_attempt_at IS NULL)))))",
          "columnName": "id"
        },
        {
          "name": "wager_transactions_status_check",
          "expression": "\"status\" in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED')",
          "definition": "check (\"status\" in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED'))",
          "columnName": "status"
        }
